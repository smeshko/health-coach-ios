# Internal planning/design docs — kept locally, not tracked in this repo.
docs/

# Swift Package Manager
.build/
Packages/
.netrc
# Top-level SwiftPM scratch dir is ignored, EXCEPT the committed package workspace definition and
# its shared schemes — so `xcodebuild test -workspace .swiftpm/xcode/package.xcworkspace` (the iOS
# snapshot-test path) is reproducible from a clean clone. Per-user xcuserdata stays ignored.
/.swiftpm/*
!/.swiftpm/xcode
/.swiftpm/xcode/*
!/.swiftpm/xcode/package.xcworkspace
/.swiftpm/xcode/package.xcworkspace/*
!/.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
!/.swiftpm/xcode/package.xcworkspace/xcshareddata
/.swiftpm/xcode/package.xcworkspace/xcshareddata/*
!/.swiftpm/xcode/package.xcworkspace/xcshareddata/xcschemes

# Xcode build output
DerivedData/
build/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Per-user Xcode state (NOT xcshareddata — shared schemes and the xcodeproj's
# resolved Package.resolved live under xcshareddata and must stay tracked).
**/xcuserdata/
*.xcuserstate
*.xcscmblueprint

# macOS
.DS_Store

# Note: Package.resolved (root + xcodeproj) is intentionally NOT ignored so
# dependency versions are reproducible from a clean clone.

# Local build secrets (Cloudflare Access service token, prod base URL)
Config/Secrets.xcconfig
