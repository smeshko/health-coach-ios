// Template for the git-ignored `Config/Secrets.xcconfig`. Copy this file to `Secrets.xcconfig`
// in the same directory and fill in the real values; Base.xcconfig `#include?`s it, so it
// overrides the empty committed defaults. NEVER commit the real file.
//
// xcconfig gotcha: `//` starts a comment even inside a value, so the URL scheme must be
// written with the empty-substitution trick `$()` splitting the slashes.
//
// Scoped to device builds (`[sdk=iphoneos*]`) on purpose: simulator builds keep the empty
// default, so the DEBUG+simulator localhost fallback (CR-1) — the local dev loop against a
// backend on this Mac — keeps working. Drop the condition to point the simulator at prod too.

API_BASE_URL[sdk=iphoneos*] = https:/$()/coach.ivot.dev

// Cloudflare Access service token (Zero Trust → Access controls → Service credentials).
// The Client Id ends in `.access`; the secret is shown exactly once at creation.
CF_ACCESS_CLIENT_ID = your-client-id.access
CF_ACCESS_CLIENT_SECRET = your-client-secret
